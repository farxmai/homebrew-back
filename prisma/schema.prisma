// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// StatsBase - This model is used to store the base stats, that can be used for buffs, bonuses, enchantments etc.
model StatsBase {
  id                   Int             @id @default(autoincrement())
  strength             Int?
  dexterity            Int?
  constitution         Int?
  intelligence         Int?
  wisdom               Int?
  charisma             Int?
  fortitude            Int?
  reflex               Int?
  will                 Int?
  speedBonus           Int?
  speedMax             Int?
  speedMod             Int?
  size                 Int?
  acArmor              Int?
  acShield             Int?
  acNatural            Int?
  acDeflection         Int?
  acMisc               Int?
  acDexterityAvailable Boolean?
  acDexterityMax       Int?
  skillPenalty         Int?
  attackMelee          Int?
  attackRanged         Int?
  attackTouch          Int?
  attackGrapple        Int?
  damageMelee          Int?
  damageRanged         Int?
  hpTemp               Int?
  resistSpell          Int?
  resistPsionic        Int?
  resistAcid           Int?
  resistCold           Int?
  resistElectricity    Int?
  resistFire           Int?
  resistSonic          Int?
  resistForce          Int?
  resistNegativeEnergy Int?
  resistPositiveEnergy Int?
  resistPoison         Int?
  resistDisease        Int?
  resistDeathEffect    Int?
  resistBlunt          Int?
  resistPiercing       Int?
  resistSlashing       Int?
  resistGood           Int?
  resistEvil           Int?
  resistLawful         Int?
  resistChaotic        Int?
  relatedRaces         CharacterRace[]
  relatedFeats         Feat[]
}

model Language {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String
  source      String

  relatedRaces      RaceOnLanguage[]
  relatedCharacters CharacterLanguages[]

  @@index([name])
}

model Character {
  id                 Int                 @id @default(autoincrement())
  name               String
  player             String // TODO: should player ID
  alignment          String
  age                Int
  gender             String
  background         String
  hp                 CharacterHp?
  abilities          CharacterAbilities?
  saves              CharacterSave?
  skills             CharacterSkill[]
  characterClasses   CharacterOnClass[]
  characterRaces     CharacterOnRace[] // halfblood, multiclass, etc.
  characterLanguages CharacterLanguages?
}

model CharacterLanguages {
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  languageId  Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int       @unique

  @@index([languageId, characterId])
}

model CharacterHp {
  id          Int       @id @default(autoincrement())
  max         Int
  current     Int
  temp        Int
  nonlethal   Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int       @unique

  @@index([characterId])
}

model CharacterAbilities {
  id          Int       @id @default(autoincrement())
  str         Int
  dex         Int
  con         Int
  int         Int
  wis         Int
  cha         Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int       @unique

  @@index([characterId])
}

model CharacterSave {
  id          Int       @id @default(autoincrement())
  fortitude   Int
  reflex      Int
  will        Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int       @unique

  @@index([characterId])
}

model CharacterOnRace {
  character       Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId     Int
  characterRace   CharacterRace @relation(fields: [characterRaceId], references: [id], onDelete: Cascade)
  characterRaceId Int

  @@id([characterId, characterRaceId])
}

model CharacterRace {
  id                    Int                @id @default(autoincrement())
  name                  String             @unique
  description           String
  descriptionShort      String
  source                String
  speed                 Int
  size                  String
  skillPointsFist       Int?
  skillPointsAfterFirst Int?
  skillBonuses          RaceOnSkillBonus[]
  stats                 StatsBase?         @relation(fields: [statsId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  statsId               Int?
  languages             RaceOnLanguage[]
  relatedCharacters     CharacterOnRace[]
  relatedFeats          RaceOnFeat[]
}

model RaceOnSkillBonus {
  characterRace   CharacterRace @relation(fields: [characterRaceId], references: [id])
  characterRaceId Int
  skill           SkillBase     @relation(fields: [skillId], references: [id])
  skillId         Int
  bonus           Int

  @@id([characterRaceId, skillId])
}

model RaceOnLanguage {
  language        Language      @relation(fields: [languageId], references: [id])
  languageId      Int
  isAutomatic     Boolean
  characterRace   CharacterRace @relation(fields: [characterRaceId], references: [id])
  characterRaceId Int

  @@id([characterRaceId, languageId])
}

model RaceOnFeat {
  feat            Feat          @relation(fields: [featId], references: [id])
  featId          Int
  characterRace   CharacterRace @relation(fields: [characterRaceId], references: [id])
  characterRaceId Int

  @@id([characterRaceId, featId])
}

model ClassLvlBonus {
  id               Int                      @id @default(autoincrement())
  characterClass   CharacterClass           @relation(fields: [characterClassId], references: [id], onDelete: Cascade)
  characterClassId Int
  level            Int
  baseAttack       Int
  fortitude        Int
  reflex           Int
  will             Int
  spellPoints      Int?
  spellsPerDay     ClassSpellPerDay[]
  spellsKnown      ClassSpellKnown[]
  bonusFeats       FeatsOnClassLevelBonus[]

  @@index([characterClassId])
}

model ClassSpellKnown {
  id            Int           @id @default(autoincrement())
  classLevel    ClassLvlBonus @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classLevelId  Int
  spellLevel    Int
  knownPerLevel Int

  @@index([classLevelId])
}

model ClassSpellPerDay {
  id           Int           @id @default(autoincrement())
  classLevel   ClassLvlBonus @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classLevelId Int
  spellLevel   Int
  perDay       Int

  @@index([classLevelId])
}

model CharacterOnClass {
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId      Int
  characterClass   CharacterClass @relation(fields: [characterClassId], references: [id], onDelete: Cascade)
  characterClassId Int
  level            Int

  @@id([characterId, characterClassId])
}

model CharacterClass {
  id                      Int                     @id @default(autoincrement())
  name                    String                  @unique
  description             String
  descriptionShort        String
  source                  String
  hitDice                 Int
  skillPointsFist         Int
  skillPointsAfterFirst   Int
  baseAttribute           String
  classLevelBonuses       ClassLvlBonus[] // ← all class level bonuses PER LEVEL, like base attack, saves, spell points, etc.
  classSkills             CharacterClassOnSkill[] // ← simple relation to skills that could maximize 
  relatedCharacters       CharacterOnClass[] // ← all characters that have this class
  relatedFeatRequirements FeatRequirement[]
}

model CharacterClassOnSkill {
  characterClass   CharacterClass @relation(fields: [characterClassId], references: [id], onDelete: Cascade)
  characterClassId Int
  skill            SkillBase      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId          Int

  @@id([characterClassId, skillId])
}

model SkillBase {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique
  description            String
  descriptionShort       String
  source                 String
  ability                String
  trainedOnly            Boolean
  armorCheckPenalty      Int
  characterSkills        CharacterSkill[] // ← all characters that have this skill
  FeatRequirementOnSkill FeatRequirementOnSkill[]
  FeatsOnSkillBonus      FeatsOnSkillBonus[]
  CharacterClassOnSkill  CharacterClassOnSkill[]
  RaceOnSkillBonus       RaceOnSkillBonus[]
}

model CharacterSkill {
  id          Int       @id @default(autoincrement())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int
  skill       SkillBase @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId     Int
  ranks       Int

  @@index([characterId, skillId])
}

model Feat {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique
  description            String
  descriptionShort       String
  source                 String
  type                   String
  isPassive              Boolean
  isFighterBonusFeat     Boolean
  isStackable            Boolean
  stats                  StatsBase?               @relation(fields: [statsId], references: [id])
  statsId                Int?
  skillBonuses           FeatsOnSkillBonus[]
  requirements           FeatRequirement[]
  // not important
  relatedFeatRequirement FeatRequirementOnFeat[]
  relatedClassLevelBonus FeatsOnClassLevelBonus[]
  relatedRaces           RaceOnFeat[]
}

model FeatsOnClassLevelBonus {
  feat              Feat          @relation(fields: [featId], references: [id])
  featId            Int
  classLevelBonus   ClassLvlBonus @relation(fields: [classLevelBonusId], references: [id])
  classLevelBonusId Int

  @@id([featId, classLevelBonusId])
}

model FeatsOnSkillBonus {
  feat    Feat      @relation(fields: [featId], references: [id])
  featId  Int
  skill   SkillBase @relation(fields: [skillId], references: [id])
  skillId Int
  bonus   Int

  @@id([featId, skillId])
}

model FeatRequirement {
  id            Int                      @id @default(autoincrement())
  feat          Feat                     @relation(fields: [featId], references: [id])
  featId        Int
  str           Int?
  dex           Int?
  con           Int?
  int           Int?
  wis           Int?
  cha           Int?
  minBaseAttack Int?
  other         String?
  casterOnly    Boolean?
  divineOnly    Boolean?
  minClassLevel Int?
  class         CharacterClass?          @relation(fields: [classId], references: [id])
  classId       Int?
  skills        FeatRequirementOnSkill[]
  feats         FeatRequirementOnFeat[]

  @@index([featId])
}

model FeatRequirementOnFeat {
  featRequirement   FeatRequirement @relation(fields: [featRequirementId], references: [id])
  featRequirementId Int
  feat              Feat            @relation(fields: [featId], references: [id])
  featId            Int

  @@id([featRequirementId, featId])
}

model FeatRequirementOnSkill {
  feat    FeatRequirement @relation(fields: [featId], references: [id])
  featId  Int
  skill   SkillBase       @relation(fields: [skillId], references: [id])
  skillId Int
  minRank Int

  @@id([featId, skillId])
}
