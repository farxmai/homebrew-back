// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// StatsBase - This model is used to store the base stats, that can be used for buffs, bonuses, enchantments etc.
model StatsBase {
  id  Int  @id @default(autoincrement())
  str Int?
  dex Int?
  con Int?
  int Int?
  wis Int?
  cha Int?

  fortitude Int?
  reflex    Int?
  will      Int?

  speedBonus Int?
  speedMax   Int?
  speedMod   Int?
  size       Int?

  acArmor              Int?
  acShield             Int?
  acNatural            Int?
  acDeflection         Int?
  acAgainstMissiles    Int?
  acMisc               Int?
  acDexterityAvailable Boolean?
  acDexterityMax       Int?
  skillPenalty         Int?

  attackMelee   Int?
  attackRanged  Int?
  attackTouch   Int?
  attackGrapple Int?
  damageMelee   Int?
  damageRanged  Int?
  hpTemp        Int?
  // TODO: weapon specific bonuses

  damageReduction         Int? // Damage reduction is a value that reduces incoming damage, e.g. DR 5/adamantine
  damageReductionBypasses String? // Damage reduction bypasses, e.g. "adamantine", "silver", etc.
  resistCritChance        Int? // Resistance to critical hits, e.g. 50% means half of the critical hits are negated

  energyResistAcid        Int?
  energyResistCold        Int?
  energyResistElectricity Int?
  energyResistFire        Int?
  energyResistSonic       Int?
  energyResistForce       Int?
  energyResistNegative    Int?
  energyResistPositive    Int?

  poisonResistance        Int? // Resistance to poison, e.g. bonus on saves vs. poison
  charmResistance         Int? // Resistance to charm effects, e.g. bonus on saves vs. charm
  fearResistance          Int? // Resistance to disease, e.g. bonus on saves vs.
  sleepResistance         Int? // Resistance to sleep effects, e.g. bonus on saves vs. sleep
  diseaseResistance       Int? // Resistance to disease, e.g. bonus on saves vs. disease
  mindAffectingResistance Int? // Resistance to mind-affecting effects, e.g. bonus on saves vs. mind-affecting
  deathResistance         Int? // Resistance to death effects, e.g. bonus on saves vs. death
  paralysisResistance     Int? // Resistance to paralysis, e.g. bonus on saves vs. paralysis
  fatigueResistance       Int? // Resistance to fatigue, e.g. bonus on saves vs. fatigue

  spellResistance     Int? // Acts like AC against spells. A caster must roll 1d20 + caster level vs. the creature’s SR to affect it.
  psionicResistance   Int?
  casterLevelModifier Int? // Caster level modifier, e.g. +2 to caster level for spells

  skillBonuses SkillBonusOnStatsBase[]

  // CONNECTIONS
  relatedRaces CharacterRace[]
  relatedFeats Feat[]
}

model SkillBonusOnStatsBase {
  stats   StatsBase @relation(fields: [statsId], references: [id])
  statsId Int
  skill   SkillBase @relation(fields: [skillId], references: [id])
  skillId Int
  bonus   Int

  @@id([statsId, skillId])
}

model Language {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String
  source      String

  relatedRaces      RaceOnLanguage[]
  relatedCharacters CharacterLanguages[]

  @@index([name])
}

model Character {
  id                 Int                 @id @default(autoincrement())
  name               String
  player             String // TODO: should player ID
  alignment          String
  age                Int
  gender             String
  background         String
  hp                 CharacterHp?
  abilities          CharacterAbilities?
  saves              CharacterSave?
  skills             CharacterSkill[]
  characterClasses   CharacterOnClass[]
  characterRaces     CharacterOnRace[] // halfblood, multiclass, etc.
  characterLanguages CharacterLanguages?
}

model CharacterLanguages {
  language    Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
  languageId  Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int       @unique

  @@index([languageId, characterId])
}

model CharacterHp {
  id          Int       @id @default(autoincrement())
  max         Int
  current     Int
  temp        Int
  nonlethal   Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int       @unique

  @@index([characterId])
}

model CharacterAbilities {
  id          Int       @id @default(autoincrement())
  str         Int
  dex         Int
  con         Int
  int         Int
  wis         Int
  cha         Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int       @unique

  @@index([characterId])
}

model CharacterSave {
  id          Int       @id @default(autoincrement())
  fortitude   Int
  reflex      Int
  will        Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int       @unique

  @@index([characterId])
}

model CharacterOnRace {
  character       Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId     Int
  characterRace   CharacterRace @relation(fields: [characterRaceId], references: [id], onDelete: Cascade)
  characterRaceId Int

  @@id([characterId, characterRaceId])
}

model CharacterRace {
  id                    Int                        @id @default(autoincrement())
  name                  String                     @unique
  description           String
  descriptionShort      String
  source                String
  speed                 Int
  size                  Int
  stats                 StatsBase?                 @relation(fields: [statsId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  statsId               Int?
  skillPointsFist       Int?
  skillPointsAfterFirst Int?
  languages             RaceOnLanguage[]
  feats                 RaceOnFeat[]
  // not important
  relatedCharacters     CharacterOnRace[]
  translations          CharacterRaceTranslation[]
}

model CharacterRaceTranslation {
  id               Int           @id @default(autoincrement())
  characterRace    CharacterRace @relation(fields: [characterRaceId], references: [id], onDelete: Cascade)
  characterRaceId  Int
  locale           String
  name             String
  description      String
  descriptionShort String

  @@index([characterRaceId])
}

model RaceOnLanguage {
  language        Language      @relation(fields: [languageId], references: [id])
  languageId      Int
  isAutomatic     Boolean
  characterRace   CharacterRace @relation(fields: [characterRaceId], references: [id])
  characterRaceId Int

  @@id([characterRaceId, languageId])
}

model RaceOnFeat {
  feat            Feat          @relation(fields: [featId], references: [id])
  featId          Int
  characterRace   CharacterRace @relation(fields: [characterRaceId], references: [id])
  characterRaceId Int

  @@id([characterRaceId, featId])
}

model ClassLvlBonus {
  id               Int                      @id @default(autoincrement())
  characterClass   CharacterClass           @relation(fields: [characterClassId], references: [id], onDelete: Cascade)
  characterClassId Int
  level            Int
  baseAttack       Int
  fortitude        Int
  reflex           Int
  will             Int
  spellPoints      Int?
  spellsPerDay     ClassSpellPerDay[]
  spellsKnown      ClassSpellKnown[]
  bonusFeats       FeatsOnClassLevelBonus[]

  @@index([characterClassId])
}

model ClassSpellKnown {
  id            Int           @id @default(autoincrement())
  classLevel    ClassLvlBonus @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classLevelId  Int
  spellLevel    Int
  knownPerLevel Int

  @@index([classLevelId])
}

model ClassSpellPerDay {
  id           Int           @id @default(autoincrement())
  classLevel   ClassLvlBonus @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classLevelId Int
  spellLevel   Int
  perDay       Int

  @@index([classLevelId])
}

model CharacterOnClass {
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId      Int
  characterClass   CharacterClass @relation(fields: [characterClassId], references: [id], onDelete: Cascade)
  characterClassId Int
  level            Int

  @@id([characterId, characterClassId])
}

model CharacterClass {
  id                    Int                         @id @default(autoincrement())
  name                  String                      @unique
  description           String
  descriptionShort      String
  source                String
  hitDice               Int
  skillPointsFist       Int
  skillPointsAfterFirst Int
  baseAttribute         String
  classLevelBonuses     ClassLvlBonus[] // ← all class level bonuses PER LEVEL, like base attack, saves, spell points, etc.
  classSkills           CharacterClassOnSkill[] // ← simple relation to skills that could maximize 
  relatedCharacters     CharacterOnClass[] // ← all characters that have this class
  relatedRequirements   Requirement[]
  translations          CharacterClassTranslation[]
}

model CharacterClassTranslation {
  id               Int            @id @default(autoincrement())
  characterClass   CharacterClass @relation(fields: [characterClassId], references: [id], onDelete: Cascade)
  characterClassId Int
  locale           String
  name             String
  description      String
  descriptionShort String

  @@index([characterClassId])
}

model CharacterClassOnSkill {
  characterClass   CharacterClass @relation(fields: [characterClassId], references: [id], onDelete: Cascade)
  characterClassId Int
  skill            SkillBase      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId          Int

  @@id([characterClassId, skillId])
}

model SkillBase {
  id                Int     @id @default(autoincrement())
  name              String  @unique
  description       String
  descriptionShort  String
  source            String
  ability           String
  trainedOnly       Boolean
  armorCheckPenalty Int

  // CONNECTIONS
  relateCharacters    CharacterSkill[] // ← all characters that have this skill
  relatedRequirements RequirementOnSkill[]
  relateClasses       CharacterClassOnSkill[]
  relateSkillBonuses  SkillBonusOnStatsBase[]
  translations        SkillBaseTranslation[]
}

model SkillBaseTranslation {
  id               Int       @id @default(autoincrement())
  skill            SkillBase @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId          Int
  locale           String
  name             String
  description      String
  descriptionShort String

  @@index([skillId])
}

model CharacterSkill {
  id          Int       @id @default(autoincrement())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int
  skill       SkillBase @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId     Int
  ranks       Int

  @@index([characterId, skillId])
}

model Feat {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique
  description            String
  descriptionShort       String
  source                 String
  type                   String
  isPassive              Boolean
  isFighterBonusFeat     Boolean
  isStackable            Boolean
  stats                  StatsBase?               @relation(fields: [statsId], references: [id])
  statsId                Int?
  requirement            Requirement?             @relation(fields: [featRequirementId], references: [id])
  requirementId          Int?
  requirementDescription String? // description of the requirement, if any
  // not important
  relatedRequirement     RequirementOnFeat[]
  relatedClassLevelBonus FeatsOnClassLevelBonus[]
  relatedRaces           RaceOnFeat[]
  featRequirementId      Int?
  translations           FeatTranslation[]
}

model FeatTranslation {
  id                     Int     @id @default(autoincrement())
  feat                   Feat    @relation(fields: [featId], references: [id], onDelete: Cascade)
  featId                 Int
  locale                 String
  name                   String
  description            String
  descriptionShort       String
  requirementDescription String? // description of the requirement, if any

  @@index([featId])
}

model FeatsOnClassLevelBonus {
  feat              Feat          @relation(fields: [featId], references: [id])
  featId            Int
  classLevelBonus   ClassLvlBonus @relation(fields: [classLevelBonusId], references: [id])
  classLevelBonusId Int

  @@id([featId, classLevelBonusId])
}

model Requirement {
  id Int @id @default(autoincrement())

  str           Int?
  dex           Int?
  con           Int?
  int           Int?
  wis           Int?
  cha           Int?
  minBaseAttack Int?
  casterOnly    Boolean?
  divineOnly    Boolean?
  minClassLevel Int?
  class         CharacterClass?      @relation(fields: [classId], references: [id])
  classId       Int?
  skills        RequirementOnSkill[]
  feats         RequirementOnFeat[]
  // CONNECTIONS
  relatedFeats  Feat[]
}

model RequirementOnFeat {
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  requirementId Int
  feat          Feat        @relation(fields: [featId], references: [id])
  featId        Int

  @@id([requirementId, featId])
}

model RequirementOnSkill {
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  requirementId Int
  skill         SkillBase   @relation(fields: [skillId], references: [id])
  skillId       Int
  minRank       Int

  @@id([requirementId, skillId])
}
